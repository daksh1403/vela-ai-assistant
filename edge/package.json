{
  "name": "vela-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "node dist/node.js",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "wrangler": "^4.45.0"
  }
}

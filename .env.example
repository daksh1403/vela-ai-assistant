# Copy to .env and supply a newly rotated, scoped key. Never commit .env.
CALLMISSED_API_KEY=replace-with-rotated-key
APP_ENV=development
PUBLIC_APP_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
CALLMISSED_BASE_URL=https://api.callmissed.com/v1
CHAT_MODEL=sarvam-105b-conversations
IMAGE_MODEL=sdxl-lightning
VOICE_LANGUAGE=en-IN
VOICE_NAME=shubh
VOICE_MAX_DURATION_SECONDS=300
LOG_LEVEL=INFO
APP_DOMAIN=localhost
ACME_EMAIL=admin@example.com
# Optional localhost-only Grafana profile
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-password
